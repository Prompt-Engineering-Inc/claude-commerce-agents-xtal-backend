# XTAL search API (https://www.xtalsearch.com/docs/integration)
XTAL_BASE_URL=https://www.xtalsearch.com
XTAL_COLLECTION=flag-and-anthem
# Leave empty to run against the public demo collection. Paid collections need a key.
XTAL_API_KEY=
# Marks every call as test traffic. Set to 0 ONLY on a collection you are billed for on purpose.
XTAL_IS_DEMO=1
# Anthropic, for the shopping agent itself
ANTHROPIC_API_KEY=
